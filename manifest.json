{
  "manifest_version": 3,
  "name": "geo-mock",
  "version": "0.1.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "activeTab", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://nominatim.openstreetmap.org/*"],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "nominatim-ua", "enabled": true, "path": "rules.json" }
    ]
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "sites.js", "bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "geo-mock"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
